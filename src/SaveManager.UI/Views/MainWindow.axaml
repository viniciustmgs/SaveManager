<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveManager.UI.ViewModels"
        xmlns:domain="using:SaveManager.Domain.Entities"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:views="using:SaveManager.UI.Views"
        xmlns:controls="using:SaveManager.UI.Views.Controls"
        x:Class="SaveManager.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SaveManager"
        Width="600" Height="700"
        MinWidth="600" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#282828"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" />

        <Grid>
            <DockPanel>

                <!-- top panel -->
                <StackPanel DockPanel.Dock="Top" Margin="12,12,12,0" Spacing="8">

                    <!-- info row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            
                            <Button Grid.Column="0"
                                    Width="140"
                                    Command="{Binding OpenCheckUpdatesCommand}">
                                <TextBlock Text="Check for updates" />
                            </Button>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding AppVersion}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="#909090"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Width="100"
                                Command="{Binding OpenHowToUseCommand}">
                            <TextBlock Text="How to use" />
                        </Button>

                    </Grid>

                    <Separator Margin="0,4,0,4" />

                    <!-- game row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Game:" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox Width="280"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding Games}"
                                          SelectedItem="{Binding SelectedGame}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>


                                <Button Width="110" Command="{Binding OpenAddGameCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Plus" Width="16" Height="16" Foreground="#4CAF50" />
                                        <TextBlock Text="Add Game" />
                                    </StackPanel>
                                </Button>

                                <Button Width="110" Command="{Binding OpenEditGamesCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <material:MaterialIcon Kind="Pencil" Width="16" Height="16" />
                                        <TextBlock Text="Edit Games" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Width="40" Height="40"
                                VerticalAlignment="Bottom"
                                IsVisible="{Binding CanConfigureHotkeys}"
                                Command="{Binding OpenSettingsCommand}">
                            <material:MaterialIcon Kind="Cog" Width="20" Height="20" />
                        </Button>
                    </Grid>

                    <!-- profile row -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Profile:" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Width="280"
                                      HorizontalAlignment="Left"
                                      IsEnabled="{Binding IsGameSelected}"
                                      ItemsSource="{Binding Profiles}"
                                      SelectedItem="{Binding SelectedProfile}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>


                            <Button Width="110"
                                    IsEnabled="{Binding IsGameSelected}"
                                    Command="{Binding OpenAddProfileCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <material:MaterialIcon Kind="Plus" Width="16" Height="16" Foreground="#4CAF50" />
                                    <TextBlock Text="Add Profile" />
                                </StackPanel>
                            </Button>

                            <Button Width="110"
                                    IsEnabled="{Binding IsGameSelected}"
                                    Command="{Binding OpenEditProfilesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <material:MaterialIcon Kind="Pencil" Width="16" Height="16" />
                                    <TextBlock Text="Edit Profiles" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- sort row -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Sort by:" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Width="140"
                                      HorizontalAlignment="Left"
                                      IsEnabled="{Binding CanManageSaves}"
                                      ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SelectedSortOption}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static vm:SaveSortOptionToTextConverter.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>      
                            </ComboBox>

                            <TextBox x:Name="SearchBox"
                                     Width="280"
                                     IsEnabled="{Binding CanManageSaves}"
                                     PlaceholderText="Search (Ctrl+F)"
                                     Text="{Binding SaveSearchText, Mode=TwoWay}"
                                     KeyDown="OnSearchBoxKeyDown"
                                     GotFocus="OnSearchBoxGotFocus"
                                     LostFocus="OnSearchBoxLostFocus" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>

                <!-- bottom panel -->
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            Margin="12,8,12,12"
                            Spacing="8">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Button Width="120"
                                IsEnabled="{Binding CanManageSaves}"
                                Command="{Binding CreateSaveCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <material:MaterialIcon Kind="Plus" Width="16" Height="16" Foreground="#4CAF50" />
                                <TextBlock Text="Create Save" />
                            </StackPanel>
                        </Button>

                        <Button Width="120"
                                IsEnabled="{Binding IsSaveSelected}"
                                Command="{Binding LoadSaveCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <material:MaterialIcon Kind="Refresh" Width="16" Height="16" Foreground="#4CAF50" />
                                <TextBlock Text="Load Save" />
                            </StackPanel>
                        </Button>

                        <Button Width="130"
                                IsEnabled="{Binding IsSaveSelected}"
                                Command="{Binding ReplaceSaveCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <material:MaterialIcon Kind="SwapHorizontal" Width="16" Height="16" Foreground="#FF9800" />
                                <TextBlock Text="Replace Save" />
                            </StackPanel>
                        </Button>

                        <Button Width="120"
                                IsEnabled="{Binding IsSaveSelected}"
                                Command="{Binding DeleteSelectedSaveCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <material:MaterialIcon Kind="TrashCan" Width="16" Height="16" Foreground="#F44336" />
                                <TextBlock Text="Delete Save" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- save tree -->
                <TreeView x:Name="SavesTree"
                          Margin="12,8,12,0"
                          Background="#424242"
                          ItemsSource="{Binding SaveTree}"
                          SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                          DragDrop.AllowDrop="True">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="New Folder"
                                      IsEnabled="{Binding CanManageSaves}"
                                      Click="OnNewFolderInEmptyAreaClick" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.Resources>
                        <x:Double x:Key="TreeViewItemIndent">10</x:Double>
                    </TreeView.Resources>
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer:not(:disabled)">
                            <Setter Property="Margin" Value="0,0,4,0" />
                        </Style>
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded"
                                    Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="ContextMenu">
                                <ContextMenu>
                                    <MenuItem Header="New Folder" Click="OnNewFolderHereClick" />
                                    <MenuItem Header="Rename" Click="OnRenameNodeClick" />
                                    <MenuItem Header="Delete" Click="OnDeleteNodeClick" />
                                </ContextMenu>
                            </Setter>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="vm:SaveTreeNode"
                                          ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <material:MaterialIcon Kind="Folder"
                                                       Width="16"
                                                       Height="16"
                                                       Foreground="#FFC107"
                                                       IsVisible="{Binding IsFolder}" />
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12"
                                           Padding="0,3" />
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

            </DockPanel>

            <!-- BELLOW ARE THE OVERLAYS -->

            <!-- game picker overlay -->

            <!-- add game overlay -->
            <Border IsVisible="{Binding IsAddGameDialogOpen}"
                    Background="#AA000000"
                    ZIndex="100">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="420"
                      Margin="24">

                    <Border Background="#282828"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1">

                        <StackPanel Spacing="12">

                            <TextBlock Text="Add Game"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Name:" />
                                <TextBox Text="{Binding NewGameName}"
                                         Background="#333333" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <TextBlock Text="Save type:" />
                                    <controls:InfoTip>
                                        <StackPanel MaxWidth="300" Spacing="6">
                                            <TextBlock Text="Single File:" FontWeight="Bold" />
                                            <TextBlock Text="If the game only uses a single file to save everything."
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Folder:" FontWeight="Bold" />
                                            <TextBlock Text="If the game uses multiple files for the save data, in that case you need the entire folder."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </controls:InfoTip>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="24"
                                            Margin="8,0,0,0">
                                    <CheckBox Content="Single File"
                                              IsChecked="{Binding NewGameIsSingleFile}" />
                                    <CheckBox Content="Folder"
                                              IsChecked="{Binding NewGameIsFolder}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <TextBlock Text="Game save location:" />
                                    <controls:InfoTip>
                                        <StackPanel MaxWidth="300" Spacing="6">
                                            <TextBlock Text="Select the save file of the game."
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Or the save folder, if you selected the save type 'Folder'."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </controls:InfoTip>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="280"
                                             IsReadOnly="True"
                                             IsEnabled="False"
                                             Text="{Binding NewGameSavePath}"
                                             TextAlignment="Right" />
                                    <Button Width="90"
                                            IsEnabled="{Binding IsNewGameSaveTypeSelected}"
                                            Command="{Binding BrowseNewGameSavePathCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <material:MaterialIcon Kind="Magnify" Width="16" Height="16" />
                                            <TextBlock Text="Search" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <TextBlock Text="Backup location:" />
                                    <controls:InfoTip>
                                        <StackPanel MaxWidth="300" Spacing="6">
                                            <TextBlock Text="The place where the app will create your saves."
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="This can be anywhere you like."
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Be aware that each profile you create for the game will create a separate folder inside this backup location."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </controls:InfoTip>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="280"
                                             IsReadOnly="True"
                                             IsEnabled="False"
                                             Text="{Binding NewGameBackupPath}"
                                             TextAlignment="Right" />
                                    <Button Width="90"
                                            IsEnabled="{Binding IsNewGameSaveTypeSelected}"
                                            Command="{Binding BrowseNewGameBackupPathCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <material:MaterialIcon Kind="Magnify" Width="16" Height="16" />
                                            <TextBlock Text="Search" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding AddGameErrorMessage}"
                                       Foreground="#F44336"
                                       IsVisible="{Binding HasAddGameError}"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Width="110"
                                        Command="{Binding CancelAddGameCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Close"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#F44336" />
                                        <TextBlock Text="Cancel" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Width="110"
                                        IsEnabled="{Binding CanConfirmAddGame}"
                                        Command="{Binding ConfirmAddGameCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Plus"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#4CAF50" />
                                        <TextBlock Text="Add Game" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- edit games overlay -->
            <Border IsVisible="{Binding IsEditGamesDialogOpen}"
                    Background="#AA000000"
                    ZIndex="100">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="420"
                      Margin="24">

                    <Border Background="#282828"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1">

                        <StackPanel Spacing="12">
                            <TextBlock Text="Edit Games"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <Grid Height="260">
                                <ListBox ItemsSource="{Binding Games}"
                                         SelectedItem="{Binding EditGamesSelectedGame}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="domain:Game">
                                            <TextBlock Text="{Binding Name}" Padding="4,5" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock x:Name="NoGamesInEditPlaceholder"
                                           Text="No Games Found"
                                           Opacity="0.6"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding Games.Count, Converter={x:Static vm:CountIsZeroVisibilityConverter.Instance}}" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Button Width="90"
                                            IsEnabled="{Binding CanEditOrDeleteSelectedGame}"
                                            Command="{Binding EditSelectedGameCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <material:MaterialIcon Kind="Pencil" Width="16" Height="16" />
                                            <TextBlock Text="Edit" />
                                        </StackPanel>
                                    </Button>

                                    <Button Width="90"
                                            IsEnabled="{Binding CanEditOrDeleteSelectedGame}"
                                            Command="{Binding DeleteSelectedGameCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <material:MaterialIcon Kind="TrashCan" Width="16" Height="16" Foreground="#F44336"/>
                                            <TextBlock Text="Delete" Foreground="#F44336" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Width="90"
                                        Command="{Binding CloseEditGamesCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="#4CAF50"/>
                                        <TextBlock Text="OK" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- edit game form overlay (nested over edit games) -->
            <Border IsVisible="{Binding IsEditGameFormOpen}"
                    Background="#AA000000"
                    ZIndex="101">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="420"
                      Margin="24">

                    <Border Background="#282828"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1">

                        <StackPanel Spacing="12">

                            <TextBlock Text="Edit Game"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Name:" />
                                <TextBox Text="{Binding EditGameName}"
                                         Background="#333333" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <TextBlock Text="Game save location:" />
                                    <controls:InfoTip>
                                        <StackPanel MaxWidth="300" Spacing="6">
                                            <TextBlock Text="Select the save file of the game."
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Or the save folder, if you selected the save type 'Folder'."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </controls:InfoTip>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="280"
                                             IsReadOnly="True"
                                             IsEnabled="False"
                                             Text="{Binding EditGameSavePath}"
                                             TextAlignment="Right" />
                                    <Button Width="90"
                                            Command="{Binding BrowseEditGameSavePathCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <material:MaterialIcon Kind="Magnify" Width="16" Height="16" />
                                            <TextBlock Text="Search" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <TextBlock Text="Backup location:" />
                                    <controls:InfoTip>
                                        <StackPanel MaxWidth="300" Spacing="6">
                                            <TextBlock Text="The place where the app will create your saves."
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="This can be anywhere you like."
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Be aware that each profile you create for the game will create a separate folder inside this backup location."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </controls:InfoTip>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="280"
                                             IsReadOnly="True"
                                             IsEnabled="False"
                                             Text="{Binding EditGameBackupPath}"
                                             TextAlignment="Right" />
                                    <Button Width="90"
                                            Command="{Binding BrowseEditGameBackupPathCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <material:MaterialIcon Kind="Magnify" Width="16" Height="16" />
                                            <TextBlock Text="Search" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding EditGameErrorMessage}"
                                       Foreground="#F44336"
                                       IsVisible="{Binding HasEditGameError}"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Width="110"
                                        Command="{Binding CancelEditGameCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Close"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#F44336" />
                                        <TextBlock Text="Cancel" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Width="110"
                                        IsEnabled="{Binding CanConfirmEditGame}"
                                        Command="{Binding ConfirmEditGameCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Check"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#4CAF50" />
                                        <TextBlock Text="Confirm" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- delete game confirmation overlay (nested over edit games) -->
            <Border IsVisible="{Binding IsDeleteGameConfirmOpen}"
                    Background="#AA000000"
                    ZIndex="101">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="420"
                      Margin="24">

                    <Border Background="#282828"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1">

                        <StackPanel Spacing="12">

                            <TextBlock Text="Delete Game"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="This will delete the game from the SaveManager's config file, but you can always add it back. The backups created will remain intact."
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Width="110"
                                        Command="{Binding CancelDeleteGameCommand}">
                                    <TextBlock Text="Cancel" />
                                </Button>

                                <Button Grid.Column="2"
                                        Width="130"
                                        Command="{Binding ConfirmDeleteGameCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Delete"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#F44336" />
                                        <TextBlock Text="Delete Game" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>


            <!-- add profile overlay -->
            <Border IsVisible="{Binding IsAddProfileDialogOpen}"
                    Background="#AA000000"
                    ZIndex="100">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="360"
                      Margin="24">

                    <Border Background="#282828"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1">

                        <StackPanel Spacing="12">

                            <TextBlock Text="Add Profile"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Name:" />
                                <TextBox Text="{Binding NewProfileName}"
                                         Background="#333333" />
                            </StackPanel>

                            <TextBlock Text="{Binding AddProfileErrorMessage}"
                                       Foreground="#F44336"
                                       IsVisible="{Binding HasAddProfileError}"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Width="110"
                                        Command="{Binding CancelAddProfileCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Close"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#F44336" />
                                        <TextBlock Text="Cancel" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Width="110"
                                        IsEnabled="{Binding CanConfirmAddProfile}"
                                        Command="{Binding ConfirmAddProfileCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Plus"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#4CAF50" />
                                        <TextBlock Text="Add Profile" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- edit profiles overlay -->
            <Border IsVisible="{Binding IsEditProfilesDialogOpen}"
                    Background="#AA000000"
                    ZIndex="100">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="420"
                      Margin="24">

                    <Border Background="#282828"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1">

                        <StackPanel Spacing="12">
                            <TextBlock Text="Edit Profiles"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <Grid Height="260">
                                <ListBox ItemsSource="{Binding Profiles}"
                                         SelectedItem="{Binding EditProfilesSelectedProfile}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="domain:Profile">
                                            <TextBlock Text="{Binding Name}" Padding="4,5" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock x:Name="NoProfilesInEditPlaceholder"
                                           Text="No Profiles Found"
                                           Opacity="0.6"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding Profiles.Count, Converter={x:Static vm:CountIsZeroVisibilityConverter.Instance}}" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Button Width="90"
                                            IsEnabled="{Binding CanEditOrDeleteSelectedProfile}"
                                            Command="{Binding EditSelectedProfileCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <material:MaterialIcon Kind="Pencil" Width="16" Height="16" />
                                            <TextBlock Text="Edit" />
                                        </StackPanel>
                                    </Button>

                                    <Button Width="90"
                                            IsEnabled="{Binding CanEditOrDeleteSelectedProfile}"
                                            Command="{Binding DeleteSelectedProfileCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <material:MaterialIcon Kind="TrashCan" Width="16" Height="16" Foreground="#F44336"/>
                                            <TextBlock Text="Delete" Foreground="#F44336" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Width="90"
                                        Command="{Binding CloseEditProfilesCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Check" Width="16" Height="16" Foreground="#4CAF50"/>
                                        <TextBlock Text="OK" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- edit profile form overlay (nested over edit profiles) -->
            <Border IsVisible="{Binding IsEditProfileFormOpen}"
                    Background="#AA000000"
                    ZIndex="101">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="360"
                      Margin="24">

                    <Border Background="#282828"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1">

                        <StackPanel Spacing="12">

                            <TextBlock Text="Edit Profile"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Name:" />
                                <TextBox Text="{Binding EditProfileName}"
                                         Background="#333333" />
                            </StackPanel>

                            <TextBlock Text="{Binding EditProfileErrorMessage}"
                                       Foreground="#F44336"
                                       IsVisible="{Binding HasEditProfileError}"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Width="110"
                                        Command="{Binding CancelEditProfileCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Close"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#F44336" />
                                        <TextBlock Text="Cancel" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Width="110"
                                        IsEnabled="{Binding CanConfirmEditProfile}"
                                        Command="{Binding ConfirmEditProfileCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Check"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#4CAF50" />
                                        <TextBlock Text="Confirm" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- delete profile confirmation overlay (nested over edit profiles) -->
            <Border IsVisible="{Binding IsDeleteProfileConfirmOpen}"
                    Background="#AA000000"
                    ZIndex="101">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="420"
                      Margin="24">

                    <Border Background="#282828"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1">

                        <StackPanel Spacing="12">

                            <TextBlock Text="Delete Profile"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="WARNING: deleting a profile will delete all the saves it contains. Do you want to proceed?"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Width="110"
                                        Command="{Binding CancelDeleteProfileCommand}">
                                    <TextBlock Text="Cancel" />
                                </Button>

                                <Button Grid.Column="2"
                                        Width="140"
                                        Command="{Binding ConfirmDeleteProfileCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Delete"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#F44336" />
                                        <TextBlock Text="Delete Profile" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- rename save overlay -->
            <Border IsVisible="{Binding IsRenameSaveDialogOpen}"
                    Background="#AA000000"
                    ZIndex="100">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="360"
                      Margin="24">

                    <Border Background="#282828"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1">

                        <StackPanel Spacing="12">

                            <TextBlock Text="Rename Save"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Name:" />
                                <TextBox Text="{Binding RenameSaveName}"
                                         Background="#333333" />
                            </StackPanel>

                            <TextBlock Text="{Binding RenameSaveErrorMessage}"
                                       Foreground="#F44336"
                                       IsVisible="{Binding HasRenameSaveError}"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Width="110"
                                        Command="{Binding CancelRenameSaveCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Close"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#F44336" />
                                        <TextBlock Text="Cancel" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Width="110"
                                        IsEnabled="{Binding CanConfirmRenameSave}"
                                        Command="{Binding ConfirmRenameSaveCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Pencil"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#4CAF50" />
                                        <TextBlock Text="Rename" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- settings overlay -->
            <Border IsVisible="{Binding IsSettingsDialogOpen}"
                    Background="#AA000000"
                    ZIndex="100">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="380"
                      Margin="24">

                    <Border Background="#282828"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1">

                        <StackPanel Spacing="12">

                            <TextBlock Text="Settings"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <CheckBox Content="Global Hotkeys"
                                      IsChecked="{Binding GlobalHotkeysEnabled}" />

                            <!-- shown when no backend could be created for this OS or session -->
                            <TextBlock Text="{Binding HotKeyUnsupportedReason}"
                                       Foreground="#F44336"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasHotKeySupportIssue}" />

                            <Separator Margin="0,4,0,4" />

                            <StackPanel Spacing="10" IsEnabled="{Binding GlobalHotkeysEnabled}">

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Create Save" VerticalAlignment="Center" />
                                    <controls:HotkeyTextBox Grid.Column="1" Width="140"
                                                             Text="{Binding CreateSaveHotkey, Mode=TwoWay}" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Load Save" VerticalAlignment="Center" />
                                    <controls:HotkeyTextBox Grid.Column="1" Width="140"
                                                             Text="{Binding LoadSaveHotkey, Mode=TwoWay}" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Next Save" VerticalAlignment="Center" />
                                    <controls:HotkeyTextBox Grid.Column="1" Width="140"
                                                             Text="{Binding NextSaveHotkey, Mode=TwoWay}" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Previous Save" VerticalAlignment="Center" />
                                    <controls:HotkeyTextBox Grid.Column="1" Width="140"
                                                             Text="{Binding PreviousSaveHotkey, Mode=TwoWay}" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Toggle Global Hotkeys" VerticalAlignment="Center" />
                                    <controls:HotkeyTextBox Grid.Column="1" Width="140"
                                                             Text="{Binding ToggleGlobalHotkeysHotkey, Mode=TwoWay}" />
                                </Grid>

                            </StackPanel>

                            <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto, Auto" ColumnSpacing="4">
                                <Button Grid.Column="1"
                                        Width="90"
                                        Command="{Binding SaveSettingsCommand}">
                                    <TextBlock Text="Save" />
                                </Button>
                                <Button Grid.Column="2"
                                        Width="90"
                                        Command="{Binding CloseSettingsCommand}">
                                    <TextBlock Text="OK" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- settings discard confirmation overlay (nested over settings) -->
            <Border IsVisible="{Binding IsSettingsDiscardPromptOpen}"
                    Background="#AA000000"
                    ZIndex="101">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="420"
                      Margin="24">

                    <Border Background="#282828"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1">

                        <StackPanel Spacing="12">

                            <TextBlock Text="Unsaved Changes"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="There are unsaved changes, would you like to discard these changes and leave?"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Width="110"
                                        Command="{Binding CancelDiscardSettingsCommand}">
                                    <TextBlock Text="Cancel" />
                                </Button>

                                <Button Grid.Column="2"
                                        Width="130"
                                        Command="{Binding DiscardSettingsChangesCommand}">
                                    <TextBlock Text="Discard Changes" />
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- delete save confirmation overlay -->
            <Border IsVisible="{Binding IsDeleteSaveConfirmOpen}"
                    Background="#AA000000"
                    ZIndex="103">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="380"
                      Margin="24">

                    <Border Background="#282828"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1">

                        <StackPanel Spacing="12">

                            <TextBlock Text="Delete Save"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <TextBlock x:Name="DeleteSavePromptText"
                                       Text="{Binding DeleteSaveConfirmMessage}"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Width="90"
                                        Command="{Binding CancelDeleteSaveCommand}">
                                    <TextBlock Text="Cancel" />
                                </Button>

                                <Button Grid.Column="2"
                                        Width="90"
                                        Command="{Binding ConfirmDeleteSaveCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="TrashCan" Width="16" Height="16" Foreground="#F44336" />
                                        <TextBlock Text="Delete" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- create folder overlay -->
            <Border IsVisible="{Binding IsCreateFolderDialogOpen}"
                    Background="#AA000000"
                    ZIndex="104">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="360"
                      Margin="24">

                    <Border Background="#282828"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1">

                        <StackPanel Spacing="12">

                            <TextBlock Text="New Folder"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Name:" />
                                <TextBox Text="{Binding NewFolderName}"
                                         Background="#333333" />
                            </StackPanel>

                            <TextBlock Text="{Binding CreateFolderErrorMessage}"
                                       Foreground="#F44336"
                                       IsVisible="{Binding HasCreateFolderError}"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Width="110"
                                        Command="{Binding CancelCreateFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Close"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#F44336" />
                                        <TextBlock Text="Cancel" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Width="110"
                                        IsEnabled="{Binding CanConfirmNewFolder}"
                                        Command="{Binding ConfirmCreateFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="FolderPlus"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#4CAF50" />
                                        <TextBlock Text="Create" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- rename folder overlay -->
            <Border IsVisible="{Binding IsRenameFolderDialogOpen}"
                    Background="#AA000000"
                    ZIndex="104">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="360"
                      Margin="24">

                    <Border Background="#282828"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1">

                        <StackPanel Spacing="12">

                            <TextBlock Text="Rename Folder"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Name:" />
                                <TextBox Text="{Binding RenameFolderName}"
                                         Background="#333333" />
                            </StackPanel>

                            <TextBlock Text="{Binding RenameFolderErrorMessage}"
                                       Foreground="#F44336"
                                       IsVisible="{Binding HasRenameFolderError}"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Width="110"
                                        Command="{Binding CancelRenameFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Close"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#F44336" />
                                        <TextBlock Text="Cancel" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Width="110"
                                        IsEnabled="{Binding CanConfirmRenameFolder}"
                                        Command="{Binding ConfirmRenameFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Pencil"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#4CAF50" />
                                        <TextBlock Text="Rename" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- delete folder confirm overlay -->
            <Border IsVisible="{Binding IsDeleteFolderConfirmOpen}"
                    Background="#AA000000"
                    ZIndex="104">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="380"
                      Margin="24">

                    <Border Background="#282828"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1">

                        <StackPanel Spacing="12">

                            <TextBlock Text="Delete Folder"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="{Binding DeleteFolderConfirmMessage}"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Width="90"
                                        Command="{Binding CancelDeleteFolderCommand}">
                                    <TextBlock Text="Cancel" />
                                </Button>

                                <Button Grid.Column="2"
                                        Width="90"
                                        Command="{Binding ConfirmDeleteFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="TrashCan" Width="16" Height="16" Foreground="#F44336" />
                                        <TextBlock Text="Delete" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- how to use -->
            <Border IsVisible="{Binding IsHowToUseOpen}"
                    Background="#AA000000"
                    ZIndex="100">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="480"
                      Margin="24">

                    <Border Background="#282828"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1">

                        <StackPanel Spacing="12">

                            <TextBlock Text="How to use"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <Border Background="#333333"
                                    CornerRadius="6"
                                    Padding="12"
                                    MaxHeight="360">

                                <ScrollViewer>
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="The purpose of this app is to aid with creating copies of the save file(s) of a game, and loading them back. This is done normally to repeat a specific section or boss fight, to practice for challenge runs or speed runs. But it can be used to create backups of saves for whatever reason you want."
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="How it works" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="When you press to create a save, the app will create a copy of the game save file(s) as it current is, and save it in the folder you provided when adding the game. When you load a specific copy (aka backup), that copy will replace the actual save of the game, restoring it to the game." />
                                            <Run Text="Note that doing this will replace the current save with the copy you wish to load, thus losing the current save." 
                                                 Foreground="#F44336"/>
                                        </TextBlock>
                                        <TextBlock Text="Adding a game" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="After writing the name of the game, you must choose the type of save.&#10;If the game uses a single file for all the save data (e.g. Dark Souls) you select" />
                                            <Run Text="Single File."
                                                 FontWeight="SemiBold"/>
                                            <Run Text="&#10;If the game uses multiple files, then you must select"/>
                                            <Run Text="Folder."
                                                 FontWeight="SemiBold"/>
                                            <Run Text="&#10;Then you must select the location of the game save file (or save folder) and the location of the backup folder. The backup folder is where the copies will be created, and it can be anywhere you want."/>
                                        </TextBlock>
                                        <TextBlock Text="Profiles" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="For each game you can create multiple profiles to separate the saves (e.g. one profile for any%, one for all bosses, etc)."/>
                                            <Run Text="&#10;Each profile will create it's own folder inside the backup folder, and that's where the actual copies will be. Be aware of that when choosing the backup folder."/>
                                            <Run Text="&#10;On each profile you can also create folders to further organize your saves."/>
                                        </TextBlock>
                                        <TextBlock Text="The buttons" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="• Creat save:" FontWeight="SemiBold"/>
                                            <Run Text="Creates a copy of the game save"/>
                                            <LineBreak/>
                                            <Run Text="• Load Save:" FontWeight="SemiBold"/>
                                            <Run Text="Loads the currently selected copy, replacing the game save"/>
                                            <LineBreak/>
                                            <Run Text="• Replace Save:" FontWeight="SemiBold"/>
                                            <Run Text="Creates a copy of the game save that automatically replaces the currently selected copy."/>
                                        </TextBlock>
                                        <TextBlock Text="Global Hotkeys (Windows only)" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="You can set global hotkeys to Create Save, Load Save, and move Up and Down in the save list, so you don't have to tab out of the game to do this. For now this is for windows only."/>
                                        </TextBlock>
                                        <TextBlock Text="Config file" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="This app creates a config.json to persist the game informations and hotkey settings.&#10;"/>
                                            <Run Text="Windows: " FontWeight="SemiBold"/>
                                            <Run Text="%APPDATA%\SaveManager\config.json&#10;"/>
                                            <Run Text="Linux: " FontWeight="SemiBold"/>
                                            <Run Text="~/.config/SaveManager/config.json"/>
                                        </TextBlock>
                                        <TextBlock Text="Limitations" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="No hotkeys for linux. I might try to add it in the future."
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="If the game uses multiple files for the save but they're not in a dedicated folder, but instead mixed in the middle of other game files. This could be an issue if there are big files within the folder that are unrelated. I don't have intentions of adding a feature for that for now, since practically all games will have a dedicated folder for the save files."
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="1"
                                        Width="110"
                                        Command="{Binding CloseHowToUseCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Check"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#4CAF50" />
                                        <TextBlock Text="OK" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- check for updates -->
            <Border IsVisible="{Binding IsCheckUpdatesOpen}"
                    Background="#AA000000"
                    ZIndex="100">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="420"
                      Margin="24">

                    <Border Background="#282828"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1">

                        <StackPanel Spacing="12">

                            <TextBlock Text="Check for updates"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <ProgressBar IsIndeterminate="True"
                                         Height="4"
                                         Margin="0,8,0,0"
                                         IsVisible="{Binding IsUpdateCheckInProgress}" />

                            <StackPanel Spacing="8"
                                        IsVisible="{Binding !IsUpdateCheckInProgress}">

                                <TextBlock Text="{Binding UpdateCheckHeadline}"
                                           FontWeight="SemiBold" />

                                <TextBlock Text="{Binding UpdateCheckMessage}"
                                           TextWrapping="Wrap"
                                           Foreground="#B0B0B0" />

                                <Button Width="220"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding IsUpdateAvailable}"
                                        Command="{Binding OpenReleasesPageCommand}"
                                        CommandParameter="{Binding UpdateCheckResult.ReleasesUrl}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="OpenInNew"
                                                               Width="16"
                                                               Height="16" />
                                        <TextBlock Text="Open releases page" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="1"
                                        Width="110"
                                        Command="{Binding CloseCheckUpdatesCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="Check"
                                                               Width="16"
                                                               Height="16"
                                                               Foreground="#4CAF50" />
                                        <TextBlock Text="OK" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- toast -->
            <views:ToastView Toast="{Binding Toast}"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center" />

            <!-- drag ghost -->
            <Canvas x:Name="DragGhostLayer"
                    ZIndex="100"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Border x:Name="DragGhost"
                        IsVisible="False"
                        Background="#3A3A3A"
                        BorderBrush="#686868"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="File"
                                               Width="14"
                                               Height="14"
                                               Foreground="#BDBDBD" />
                        <TextBlock x:Name="DragGhostText"
                                   FontSize="12"
                                   Foreground="White" />
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>
    </DockPanel>
</Window>